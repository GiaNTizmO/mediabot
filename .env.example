# Токен от @BotFather
BOT_TOKEN=
# Лимит размера файла в МБ. 50 для обычного Bot API, до 2000 если используете локальный Bot API сервер
MAX_FILE_MB=50
# (необязательно) URL локального telegram-bot-api, напр. http://telegram-bot-api:8081
LOCAL_API_URL=
# (необязательно) Список разрешённых user id через запятую. Пусто = доступ для всех
ALLOWED_USERS=
# (необязательно) Путь к cookies.txt (нужен для части видео Instagram/YouTube)
COOKIES_FILE=
# Сколько загрузок может идти одновременно (на весь бот)
MAX_CONCURRENT=3
# Папка для кэша file_id (sqlite)
DATA_DIR=data
# (только для локального Bot API в docker-compose) https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
