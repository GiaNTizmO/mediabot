# Токен от @BotFather
BOT_TOKEN=
# Лимит размера файла в МБ. Максимум 50 для обычного Bot API, 2000 — с локальным Bot API сервером
MAX_FILE_MB=50
# (необязательно) Локальный Bot API для файлов до 2 ГБ (см. README «Большие файлы»):
# COMPOSE_PROFILES=local-api  (или pot,local-api), MAX_FILE_MB=2000 и TELEGRAM_API_ID/HASH ниже
LOCAL_API_URL=
# (необязательно) Список разрешённых user id через запятую. Пусто = доступ для всех
ALLOWED_USERS=
# (необязательно) Путь к cookies.txt (нужен для части видео Instagram/YouTube)
COOKIES_FILE=
# Сколько загрузок может идти одновременно (на весь бот)
MAX_CONCURRENT=3
# Папка для кэша file_id (sqlite)
DATA_DIR=data
# (только для локального Bot API) https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# (необязательно) Где хранить временные файлы на время загрузки. По умолчанию системный /tmp.
# Файлы удаляются сразу после отправки в Telegram.
TEMP_DIR=
# (необязательно) PO-токены для YouTube на серверных IP: раскомментируйте обе строки
# (если нужен и локальный Bot API — COMPOSE_PROFILES=pot,local-api)
# COMPOSE_PROFILES=pot
# POT_PROVIDER_URL=http://pot-provider:4416
