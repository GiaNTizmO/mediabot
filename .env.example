# Токен от @BotFather
BOT_TOKEN=
# Лимит размера файла в МБ. 50 для обычного Bot API, до 2000 если используете локальный Bot API сервер
MAX_FILE_MB=50
# (необязательно) URL локального telegram-bot-api, напр. http://localhost:8081
LOCAL_API_URL=
# (необязательно) Список разрешённых user id через запятую. Пусто = доступ для всех
ALLOWED_USERS=
# (необязательно) Путь к cookies.txt (нужен для части видео Instagram/YouTube)
COOKIES_FILE=
